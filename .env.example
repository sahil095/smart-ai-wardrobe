# ---- Wardrobe AI environment configuration ----
# Copy this file to ".env" and fill in your values.

# Database (default: local SQLite file. For MySQL use:
# mysql+pymysql://user:password@localhost:3306/wardrobe_ai )
DATABASE_URL=sqlite:///./wardrobe.db

# Groq API (required for AI outfit recommendations)
# Recommended production model (replaces the retired llama-3.3-70b-versatile).
# Alternatives: openai/gpt-oss-20b (faster/cheaper).
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Cloudinary (optional). If left blank, images are stored locally
# under app/static/uploads and served from there.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Number of outfits the AI should return
OUTFIT_COUNT=2
